{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "campready.phase5.review_item.v1",
  "title": "CampReady Phase 5 review item",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","review_item_id","upstream_event_id","affected_relationship_id","detected_at","retrieved_at","site_id","campground_name","authority_id","authority_name","source_family","source_role","official_source_url","source_title","source_evidence","source_evidence_digest","provenance_run_id","provenance_record_ref","event_category","lifecycle_classification","prior_accepted_state_ref","current_accepted_state_ref","retrieval_status","parser_status","relevance_status","data_quality_state","unknown_state","retry_telemetry_summary","reviewer_status","reviewer_disposition","reviewer_acknowledgement","reviewer_note","annotation_ref","alert_detail_guard_required","notification_eligible","interpretation_prohibitions"],
  "properties": {
    "schema_version":{"const":"campready.phase5.review_item.v1"},
    "review_item_id":{"type":"string","pattern":"^cr5ri1-[0-9a-f]{64}$"},
    "upstream_event_id":{"type":["string","null"]},
    "affected_relationship_id":{"type":"string","minLength":1},
    "detected_at":{"$ref":"#/$defs/utcTimestamp"},
    "retrieved_at":{"anyOf":[{"$ref":"#/$defs/utcTimestamp"},{"type":"null"}]},
    "site_id":{"type":"string","minLength":1},
    "campground_name":{"type":"string","minLength":1},
    "authority_id":{"type":"string","minLength":1},
    "authority_name":{"type":"string","minLength":1},
    "source_family":{"type":"string","minLength":1},
    "source_role":{"type":"string","minLength":1},
    "official_source_url":{"type":"string","pattern":"^https://"},
    "source_title":{"$ref":"#/$defs/sourceTitle"},
    "source_evidence":{"$ref":"#/$defs/sourceEvidence"},
    "source_evidence_digest":{"type":["string","null"],"pattern":"^(sha256:)?[0-9a-f]{64}$"},
    "provenance_run_id":{"type":"string","minLength":1},
    "provenance_record_ref":{"type":"string","minLength":1},
    "event_category":{"type":["string","null"]},
    "lifecycle_classification":{"type":"string","enum":["APPEARANCE","DISAPPEARANCE","RESOLUTION","MATERIAL_UPDATE","UNCHANGED","NONE"]},
    "prior_accepted_state_ref":{"type":["string","null"]},
    "current_accepted_state_ref":{"type":["string","null"]},
    "retrieval_status":{"enum":["SUCCESS","FAILED_FIRST_ATTEMPT_RESCUED","FINAL_FAILED"]},
    "parser_status":{"enum":["SUCCESS","FAILED","NOT_RUN","NOT_APPLICABLE"]},
    "relevance_status":{"enum":["RELEVANT","NOT_RELEVANT","UNKNOWN","NOT_EVALUATED"]},
    "data_quality_state":{"$ref":"#/$defs/qualityState"},
    "unknown_state":{"$ref":"#/$defs/unknownState"},
    "retry_telemetry_summary":{"anyOf":[{"$ref":"#/$defs/retry"},{"type":"null"}]},
    "reviewer_status":{"const":"NEW"},
    "reviewer_disposition":{"type":"null"},
    "reviewer_acknowledgement":{"$ref":"#/$defs/acknowledgement"},
    "reviewer_note":{"type":"null"},
    "annotation_ref":{"type":"null"},
    "alert_detail_guard_required":{"type":"boolean"},
    "notification_eligible":{"const":false},
    "interpretation_prohibitions":{"type":"array","items":{"type":"string"},"uniqueItems":true}
  },
  "$defs": {
    "utcTimestamp":{"type":"string","format":"date-time","pattern":"(?:Z|[+]00:00)$"},
    "sourceTitle":{"type":"object","additionalProperties":false,"required":["status","value","reason_code"],"properties":{"status":{"enum":["AVAILABLE","UNKNOWN"]},"value":{"type":["string","null"]},"reason_code":{"type":["string","null"]}}},
    "sourceEvidence":{"type":"object","additionalProperties":false,"required":["representation","content","unavailable_reason_code"],"properties":{"representation":{"enum":["VERBATIM","SUMMARY","UNAVAILABLE"]},"content":{"type":["string","null"],"maxLength":4000},"unavailable_reason_code":{"type":["string","null"]}}},
    "qualityState":{"type":"object","additionalProperties":false,"required":["classification","reason_code"],"properties":{"classification":{"enum":["NONE","DATA_QUALITY"]},"reason_code":{"type":["string","null"]}}},
    "unknownState":{"type":"object","additionalProperties":false,"required":["unknown","reason_code"],"properties":{"unknown":{"type":"boolean"},"reason_code":{"type":["string","null"]}}},
    "retry":{"type":"object","additionalProperties":false,"required":["attempted","max_attempts","rescued","final_failed","first_attempt_status","eventual_status"],"properties":{"attempted":{"type":"integer","minimum":1},"max_attempts":{"type":"integer","minimum":1},"rescued":{"type":"boolean"},"final_failed":{"type":"boolean"},"first_attempt_status":{"type":"string"},"eventual_status":{"type":"string"}}},
    "acknowledgement":{"type":"object","additionalProperties":false,"required":["acknowledged","acknowledged_at","reviewer_id","annotation_version","acknowledged_status","acknowledged_disposition"],"properties":{"acknowledged":{"const":false},"acknowledged_at":{"type":"null"},"reviewer_id":{"type":"null"},"annotation_version":{"type":"null"},"acknowledged_status":{"type":"null"},"acknowledged_disposition":{"type":"null"}}}
  }
}
