{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "campready.phase5.pilot_observation.v1",
  "title": "CampReady Phase 5-5 bounded pilot observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","observation_id","intake_sequence","review_item_id","site_id","campground_name","affected_relationship_id","source_role","source_authority","source_evidence_ref","event_category","system_classification","relevance_status","quality_defect_basis","data_quality_state","guard_required","retrieval_first_attempt_outcome","retrieval_eventual_outcome","parser_status","rescued_retry","reviewer_disposition","reviewer_code","review_started_at","review_completed_at","acknowledgement_required","acknowledgement_completed","correction_required","correction_reason","correction_before_downstream_transition","corrected_item_unresolved","adjudication_required","adjudication_completed","confirmed_structured_disposition_incompatibility","comprehension_error_classes","control_sample_selected","secondary_reviewer_code","secondary_disposition","disagreement_type","maintenance_minutes_attributable","review_minutes","adjudication_minutes","correction_minutes","notes_or_rationale","unsafe_inference","protocol_integrity_status","evidence_refs"],
  "properties": {
    "schema_version":{"const":"campready.phase5.pilot_observation.v1"},
    "observation_id":{"type":"string","pattern":"^cr5pilotobs1-[0-9a-f]{64}$"},
    "intake_sequence":{"type":"integer","minimum":1,"maximum":100},
    "review_item_id":{"type":"string","pattern":"^cr5ri1-[0-9a-f]{64}$"},
    "site_id":{"enum":["andrews-cove","low-gap","nc-van-hook-glade","wv-big-rock","or-spinreel","or-cold-springs","ncsp-carolina-beach","ncsp-stone-mountain","nps-elkmont","nps-big-meadows"]},
    "campground_name":{"type":"string","minLength":1},
    "affected_relationship_id":{"type":"string","minLength":1},
    "source_role":{"enum":["ACTIVE_ALERT","CAMPGROUND_PAGE","ALERT_DETAIL"]},
    "source_authority":{"type":"string","minLength":1},
    "source_evidence_ref":{"type":"string","minLength":1},
    "event_category":{"type":["string","null"],"enum":["WEATHER_ALERT","CAMPGROUND_CONDITION",null]},
    "system_classification":{"type":"string","minLength":1},
    "relevance_status":{"enum":["RELEVANT","NOT_RELEVANT","UNKNOWN","NOT_EVALUATED"]},
    "quality_defect_basis":{"enum":["NONE","RETRIEVAL","PARSER","PROVENANCE","EVIDENCE_INTEGRITY","OTHER_STRUCTURED_DEFECT"]},
    "data_quality_state":{"enum":["NONE","DATA_QUALITY"]},
    "guard_required":{"type":"boolean"},
    "retrieval_first_attempt_outcome":{"enum":["SUCCESS","FAILED","NOT_APPLICABLE"]},
    "retrieval_eventual_outcome":{"enum":["SUCCESS","FINAL_FAILED","NOT_APPLICABLE"]},
    "parser_status":{"enum":["SUCCESS","FAILED","NOT_RUN","NOT_APPLICABLE"]},
    "rescued_retry":{"type":"boolean"},
    "reviewer_disposition":{"enum":["REVIEWED_VALID","REVIEWED_NOT_ACTIONABLE","DATA_QUALITY_HOLD","NEEDS_FOLLOWUP","ACKNOWLEDGED"]},
    "reviewer_code":{"const":"PRIMARY_REVIEWER"},
    "review_started_at":{"$ref":"#/$defs/utc"},
    "review_completed_at":{"$ref":"#/$defs/utc"},
    "acknowledgement_required":{"type":"boolean"},
    "acknowledgement_completed":{"type":"boolean"},
    "correction_required":{"type":"boolean"},
    "correction_reason":{"type":["string","null"],"maxLength":2000},
    "correction_before_downstream_transition":{"type":["boolean","null"]},
    "corrected_item_unresolved":{"type":["boolean","null"]},
    "adjudication_required":{"type":"boolean"},
    "adjudication_completed":{"type":"boolean"},
    "confirmed_structured_disposition_incompatibility":{"type":"boolean"},
    "comprehension_error_classes":{"type":"array","uniqueItems":true,"items":{"enum":["UNKNOWN_DATA_QUALITY_CONFUSION","GUARD_COMPREHENSION_ERROR","DISPOSITION_ACTION_CONFLICT","ACKNOWLEDGEMENT_WORKFLOW_ERROR","PROVENANCE_COMPREHENSION_ERROR","SOURCE_SYSTEM_REVIEW_BOUNDARY_ERROR","UNSAFE_INFERENCE","OTHER_REVIEWER_WORKFLOW_ERROR"]}},
    "control_sample_selected":{"type":"boolean"},
    "secondary_reviewer_code":{"type":["string","null"],"enum":["SECOND_REVIEWER",null]},
    "secondary_disposition":{"type":["string","null"],"enum":["REVIEWED_VALID","REVIEWED_NOT_ACTIONABLE","DATA_QUALITY_HOLD","NEEDS_FOLLOWUP","ACKNOWLEDGED",null]},
    "disagreement_type":{"type":["string","null"],"enum":["ALLOWED_DISCRETIONARY_DIFFERENCE","CONTRACT_CRITICAL_DISAGREEMENT","SAFETY_CRITICAL_DISAGREEMENT",null]},
    "maintenance_minutes_attributable":{"type":"integer","minimum":0},
    "review_minutes":{"type":"number","minimum":0},
    "adjudication_minutes":{"type":"number","minimum":0},
    "correction_minutes":{"type":"number","minimum":0},
    "notes_or_rationale":{"type":["string","null"],"maxLength":4000},
    "unsafe_inference":{"type":"boolean"},
    "protocol_integrity_status":{"enum":["VALID","MATERIALLY_CORRUPTED"]},
    "evidence_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "unknown_none_dq_hold_conflict":{"type":"boolean","description":"Derived audit field; never rewrites reviewer or runtime state."}
  },
  "allOf": [
    {"if":{"properties":{"relevance_status":{"const":"UNKNOWN"},"quality_defect_basis":{"const":"NONE"},"reviewer_disposition":{"const":"DATA_QUALITY_HOLD"}},"required":["relevance_status","quality_defect_basis","reviewer_disposition"]},"then":{"required":["unknown_none_dq_hold_conflict"],"properties":{"unknown_none_dq_hold_conflict":{"const":true}}},"else":{"required":["unknown_none_dq_hold_conflict"],"properties":{"unknown_none_dq_hold_conflict":{"const":false}}}},
    {"if":{"properties":{"correction_required":{"const":true}}},"then":{"properties":{"correction_reason":{"type":"string","minLength":1},"correction_before_downstream_transition":{"type":"boolean"},"corrected_item_unresolved":{"type":"boolean"}}}},
    {"if":{"properties":{"control_sample_selected":{"const":true}}},"then":{"properties":{"secondary_reviewer_code":{"const":"SECOND_REVIEWER"},"secondary_disposition":{"type":"string"},"adjudication_required":{"const":true}}},"else":{"properties":{"secondary_reviewer_code":{"type":"null"},"secondary_disposition":{"type":"null"},"disagreement_type":{"type":"null"}}}},
    {"if":{"properties":{"confirmed_structured_disposition_incompatibility":{"const":true}}},"then":{"properties":{"adjudication_required":{"const":true},"adjudication_completed":{"const":true},"comprehension_error_classes":{"minItems":1}}}},
    {"if":{"properties":{"unsafe_inference":{"const":true}}},"then":{"properties":{"comprehension_error_classes":{"contains":{"const":"UNSAFE_INFERENCE"}}}}}
  ],
  "$defs":{"utc":{"type":"string","format":"date-time","pattern":"(?:Z|[+]00:00)$"}}
}
