{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"campready.phase5.qualification_response.v2",
  "type":"object","additionalProperties":false,
  "required":["qualification_version","instrument_digest","reviewer_id","started_at","submitted_at","independence_attestation","glossary_read_attestation","cases"],
  "properties":{"qualification_version":{"const":"phase5-4-v2"},"instrument_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"reviewer_id":{"enum":["R-C","R-D"]},"started_at":{"$ref":"#/$defs/time"},"submitted_at":{"$ref":"#/$defs/time"},"independence_attestation":{"const":true},"glossary_read_attestation":{"const":true},"cases":{"type":"array","minItems":12,"maxItems":12,"items":{"$ref":"#/$defs/case"}}},
  "$defs":{"time":{"type":"string","format":"date-time","pattern":"(?:Z|[+]00:00)$"},"yesno":{"enum":["YES","NO"]},"case":{"type":"object","additionalProperties":false,"required":["case_id","source_fact_identified","system_classification_identified","reviewer_annotation_boundary_understood","official_provenance_identified","selected_reviewer_action","data_quality_or_semantic_change","guard_required","safe_to_infer_appearance","safe_to_infer_disappearance","safe_to_infer_resolution","safe_to_infer_trip_safety","safe_to_infer_road_passability","safe_to_treat_source_silence_as_safe","acknowledgement_required","shared_event_proves_duplicate_relationships","acknowledgement_means_safe_or_notification_approved","reviewer_note"],"properties":{"case_id":{"pattern":"^Q(?:0[1-9]|1[0-2])$"},"source_fact_identified":{"type":"boolean"},"system_classification_identified":{"type":"boolean"},"reviewer_annotation_boundary_understood":{"type":"boolean"},"official_provenance_identified":{"type":"boolean"},"selected_reviewer_action":{"enum":["REVIEWED_VALID","REVIEWED_NOT_ACTIONABLE","DATA_QUALITY_HOLD","NEEDS_FOLLOWUP","ACKNOWLEDGED"]},"data_quality_or_semantic_change":{"enum":["DATA_QUALITY","SEMANTIC_CHANGE","NEITHER","UNKNOWN"]},"guard_required":{"$ref":"#/$defs/yesno"},"safe_to_infer_appearance":{"$ref":"#/$defs/yesno"},"safe_to_infer_disappearance":{"$ref":"#/$defs/yesno"},"safe_to_infer_resolution":{"$ref":"#/$defs/yesno"},"safe_to_infer_trip_safety":{"$ref":"#/$defs/yesno"},"safe_to_infer_road_passability":{"$ref":"#/$defs/yesno"},"safe_to_treat_source_silence_as_safe":{"$ref":"#/$defs/yesno"},"acknowledgement_required":{"$ref":"#/$defs/yesno"},"shared_event_proves_duplicate_relationships":{"$ref":"#/$defs/yesno"},"acknowledgement_means_safe_or_notification_approved":{"$ref":"#/$defs/yesno"},"reviewer_note":{"type":["string","null"],"maxLength":2000}}}}
}
