{
  "schema_version": "campready.phase5.qualification_instrument.v3",
  "qualification_version": "phase5-4-v3",
  "purpose": "Prospective independent qualification of the frozen review contract; not a trip-safety determination, a Phase 5-4 result, or Phase 5-5 authorization.",
  "glossary": {
    "SOURCE FACT": "Persisted information obtained from an official source or its evidence record.",
    "SYSTEM CLASSIFICATION": "A bounded classification produced by the system; it is not a human review annotation.",
    "REVIEWER ANNOTATION": "A human workflow record kept separate from source facts and system classifications.",
    "DATA_QUALITY": "A retrieval, parser, provenance, or evidence-integrity failure prevented reliable evidence acquisition or interpretation.",
    "UNKNOWN": "Available system evidence does not support a determinate semantic conclusion and does not imply semantic change or safety. A successfully rescued temporary first-attempt transport failure does not by itself make the final accepted observation DATA_QUALITY.",
    "guarded ALERT_DETAIL final failure": "A USFS ALERT_DETAIL logical request whose retrieval is FINAL_FAILED, with the required quality, provenance, retry, and no-inference shape. A rescued retry is not guarded.",
    "workflow action": "The reviewer action recorded as a separate annotation.",
    "transition permitted": "The workflow allows a transition.",
    "transition required": "The frozen contract imposes an obligation. The existence of an allowed transition does not by itself make that transition mandatory.",
    "manual acknowledgement": "A human-recorded explicit acknowledgement; it is not safety or notification approval.",
    "ACKNOWLEDGED": "A terminal workflow envelope over the recorded disposition, not a semantic resolution, safety finding, notification authorization, or delivery record.",
    "unresolved follow-up": "A condition that remains unresolved after NEEDS_FOLLOWUP; acknowledgement requires the prescribed unresolved-follow-up note and does not erase the condition."
  },
