        "data_quality_hold_permitted",
        "later_acknowledged_transition_available",
        "eventual_acknowledgement_required",
        "data_quality_alone_creates_acknowledgement_obligation",
        "acknowledgement_means_safety_or_notification_approval"
      ]
    },
